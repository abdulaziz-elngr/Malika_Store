# Public site URL (used for metadata and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production: 32+ random characters, e.g.  openssl rand -base64 48
# Signs the short-lived guest order-confirmation cookie. Never commit the real value.
AUTH_SECRET=

# PostgreSQL connection string (required in production). Add ?sslmode=require for managed databases.
# When empty, local development uses an embedded PostgreSQL (PGlite) in .data/
DATABASE_URL=
DATABASE_POOL_MAX=10

# Only to try `npm run build && npm start` locally without PostgreSQL. Never set in production.
# ALLOW_EMBEDDED_DB=1

# First Super Admin, read once by `npm run db:bootstrap` (12+ chars, upper + lower + number). Remove afterwards.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# New-order email alerts (SMTP). Recipients are managed in Admin → Settings → "New-order email alerts".
# Gmail example: host smtp.gmail.com, port 465, user = your Gmail, pass = a 16-char "App password"
# (Google Account → Security → 2-Step Verification → App passwords). Never use your normal password.
SMTP_HOST=
SMTP_PORT=465
# SMTP_SECURE=true        # defaults to true on port 465, false otherwise (STARTTLS)
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="MALIKA <orders@your-domain.com>"   # optional, defaults to MALIKA <SMTP_USER>

